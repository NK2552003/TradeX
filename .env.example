# TradeX Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file containing real secret keys to Git.

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional dedicated Dart worker URL. Empty uses Supabase ai-gateway.
COPILOT_API_URL=

# Copilot server only. Never add this key to assets/config/client.env.
OPEN_AI_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4
OPENAI_VOICE_MODEL=gpt-realtime
COPILOT_HOST=127.0.0.1
COPILOT_PORT=8787
COPILOT_DATA_DIR=.copilot-data
# Comma-separated browser origins for deployed web clients.
COPILOT_ALLOWED_ORIGINS=
# Explicit loopback-only development mode; normal use verifies Supabase login.
COPILOT_LOCAL_OWNER=false

# Optional isolated OpenBot computer service (see docs/copilot.md).
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
COMPUTER_NAMESPACE=opendots

# Optional Slack Events integration.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_OWNER_ID=
SLACK_TEAM_ID=
SLACK_ALLOWED_USER_IDS=
SLACK_SPECIALIST_ID=analyst

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Publishable client keys. The test RevenueCat key works only with Test Store.
REVENUECAT_TEST_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_IOS_API_KEY=
RAZORPAY_TEST_KEY_ID=
