{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphajournal",
  "compatibility_date": "2026-04-01",
  "previews": {},
  "main": "./worker/index.js",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "alphajournal.in", "custom_domain": true },
    { "pattern": "www.alphajournal.in", "custom_domain": true },
    { "pattern": "app.alphajournal.in", "custom_domain": true },
    { "pattern": "community.alphajournal.in", "custom_domain": true },
    { "pattern": "admin.alphajournal.in", "custom_domain": true },
    { "pattern": "affiliate.alphajournal.in", "custom_domain": true }
  ]
}


